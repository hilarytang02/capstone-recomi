rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isFollower() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/userFollows/$(request.auth.uid + "_" + uid));
      }

      function listVisibility() {
        return resource.data.visibility;
      }

      function isPublicList() {
        return !("visibility" in resource.data) || listVisibility() == "public";
      }

      function isFollowersList() {
        return "visibility" in resource.data && listVisibility() == "followers";
      }

      allow read: if isSignedIn();
      allow write: if isOwner();

      match /lists/{listId} {
        allow read: if isOwner()
          || isPublicList()
          || (isFollowersList() && isFollower());

        allow write: if isOwner();
      }
    }

    match /userFollows/{followId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followeeId != request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;

      allow update: if false;
    }

    match /placeStats/{placeId} {
      function validPlaceStatsWrite() {
        return request.resource.data.keys().hasOnly([
          "wishlistCount",
          "favouriteCount",
          "recentSaverIds",
          "recentWishlistSaverIds",
          "recentFavouriteSaverIds",
          "lat",
          "lng",
          "label",
          "placeId",
          "updatedAt"
        ])
        && request.resource.data.wishlistCount is int
        && request.resource.data.wishlistCount >= 0
        && request.resource.data.favouriteCount is int
        && request.resource.data.favouriteCount >= 0
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && (!("label" in request.resource.data) || request.resource.data.label == null || request.resource.data.label is string)
        && (!("placeId" in request.resource.data) || request.resource.data.placeId == null || request.resource.data.placeId is string);
      }

      allow read: if request.auth != null;
      allow write: if request.auth != null && validPlaceStatsWrite();

      match /userSaves/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid
          && (request.resource.data.bucket == "wishlist" || request.resource.data.bucket == "favourite");
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /invites/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false;
    }

    match /listLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.saverId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.saverId == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
