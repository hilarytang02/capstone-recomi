rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isFollower() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/userFollows/$(request.auth.uid + "_" + uid));
      }

      function listVisibility() {
        return resource.data.visibility;
      }

      function isPublicList() {
        return !("visibility" in resource.data) || listVisibility() == "public";
      }

      function isFollowersList() {
        return "visibility" in resource.data && listVisibility() == "followers";
      }

      allow read: if isSignedIn() || (!isSignedIn() && request.resource == null);
      allow write: if isOwner();

      match /lists/{listId} {
        allow read: if isOwner()
          || isPublicList()
          || (isFollowersList() && isFollower());

        allow write: if isOwner();
      }
    }

    match /userFollows/{followId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followeeId != request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;

      allow update: if false;
    }

    match /placeStats/{placeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /userSaves/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /invites/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false;
    }

    match /listLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.saverId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.saverId == request.auth.uid;
      allow update: if false;
    }
  }
}
